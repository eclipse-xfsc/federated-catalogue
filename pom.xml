                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${plugin.enforcer.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${plugin.maven-license.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${plugin.jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${plugin.openapi-generator.version}</version>
                    <configuration>
                        <generateApiTests>false</generateApiTests>
                        <generateModelTests>false</generateModelTests>
                        <generateApiDocumentation>false</generateApiDocumentation>
                        <generateModelDocumentation>false</generateModelDocumentation>
                        <configOptions>
                            <!--serializableModel>true</serializableModel-->
                            <useSwaggerUI>true</useSwaggerUI>
                            <useSpringBoot3>true</useSpringBoot3>
                        </configOptions>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${plugin.jib.version}</version>
                    <configuration>
                        <container>
			                <!-- ${maven.build.timestamp} should work also -->
                            <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                        </container>
                        <from>
                            <image>bellsoft/liberica-openjdk-alpine:21</image>
                        </from>
                        <!-- Turn it off for all the modules, but
                            turn it on in server module only -->
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-copyleft-neo4j-outside-test-scope</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- The embedded Neo4j server stack is GPL-3.0-or-later and must never be
                                         redistributed inside this Apache-2.0 project's jars or container images.
                                         Test scope stays allowed: it is not packaged.

                                         Only the entry points of that stack are listed. The rule resolves
                                         transitively, and the GPL kernel/cypher tree is only reachable through
                                         org.neo4j:neo4j or a direct neo4j-kernel dependency, so banning those two
                                         plus the harness covers the whole tree. A blanket org.neo4j:neo4j* glob
                                         would also hit org.neo4j:neo4j-cypher-dsl, which is Apache-2.0 and comes in
                                         via spring-boot-starter-data-neo4j.

                                         Unaffected: org.neo4j.driver:* (Apache-2.0, the only Neo4j code production
                                         links against) and org.neo4j:neosemantics.

                                         Exclude pattern: groupId:artifactId:version:type:scope:classifier -->
                                    <excludes>
                                        <exclude>org.neo4j.gds:*:*:*:compile</exclude>
                                        <exclude>org.neo4j.gds:*:*:*:runtime</exclude>
                                        <exclude>org.neo4j.gds:*:*:*:provided</exclude>
                                        <exclude>org.neo4j.test:*:*:*:compile</exclude>
                                        <exclude>org.neo4j.test:*:*:*:runtime</exclude>
                                        <exclude>org.neo4j.test:*:*:*:provided</exclude>
                                        <exclude>org.neo4j:neo4j:*:*:compile</exclude>
                                        <exclude>org.neo4j:neo4j:*:*:runtime</exclude>
                                        <exclude>org.neo4j:neo4j:*:*:provided</exclude>
                                        <exclude>org.neo4j:neo4j-kernel:*:*:compile</exclude>
                                        <exclude>org.neo4j:neo4j-kernel:*:*:runtime</exclude>
                                        <exclude>org.neo4j:neo4j-kernel:*:*:provided</exclude>
                                    </excludes>
                                    <message>
                                        GPL-3.0 Neo4j content outside test scope. The embedded Neo4j server
                                        (neo4j-harness, Neo4j Community kernel) and Graph Data Science are
                                        GPL-licensed and must not be packaged into this Apache-2.0 project.
                                        Production code must use org.neo4j.driver:neo4j-java-driver only.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <configuration>
                    <includes>**/*.java</includes>
                    <!-- Custom repo-local resolver: the plugin's bundled "apache_v2" template has no
                         SPDX line (confirmed by extracting the plugin jar), so a project-local
                         license-template/ directory (licenses.properties + eclipse_apache_v2/header.txt)
                         supplies the Eclipse Foundation SPDX header text instead. The license name is
                         deliberately NOT "apache_v2": that name collides with the plugin's bundled
                         classpath template, which takes priority over the external resolver and would
                         silently defeat this custom header.
                         ${maven.multiModuleProjectDirectory} is anchored by the .mvn/ directory at the
                         repo root; without it Maven resolves the property to the invocation directory,
                         and a build started from a module directory would not find license-template/. -->
                    <licenseResolver>file:${maven.multiModuleProjectDirectory}/license-template</licenseResolver>
                    <licenseName>eclipse_apache_v2</licenseName>
                    <copyrightOwners>Contributors to the Eclipse Foundation</copyrightOwners>
                    <copyrightStringFormat>Copyright (c) %1$s %2$s</copyrightStringFormat>
                    <processStartTag>---license-start</processStartTag>
                    <processEndTag>---license-end</processEndTag>
                    <sectionDelimiter>---</sectionDelimiter>
                    <addJavaLicenseAfterPackage>true</addJavaLicenseAfterPackage>
                    <trimHeaderLine>true</trimHeaderLine>
                    <emptyLineAfterHeader>true</emptyLineAfterHeader>
                    <!-- lineSeparator intentionally left unset: it defaults to the JVM's
                         line.separator (LF on the build machines used for this project), which
                         matches the dominant convention in this codebase. A handful of pre-existing
                         files use CRLF; those are normalized to LF as a side effect of the plugin
                         rewriting the file, with no logic or content change. -->
                    <outputDirectory>.</outputDirectory>
                    <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                    <!-- Restrict to src only: the default roots also include
                         target/generated-sources, which would header-stamp OpenAPI-generated
                         classes on every build. -->
                    <roots>
                        <root>${project.basedir}/src</root>
                    </roots>
                </configuration>
                <executions>
                    <!-- Dry-run validation gate: fails the build if a source file under src/ is
                         missing the header entirely. Does not rewrite files here (dryRun=true); the
                         actual header sweep is applied out-of-band via `mvn license:update-file-header`
                         and committed, so this execution only guards against future regressions
                         (e.g. a new file added without running the sweep first).
                         failOnNotUptodateHeader is intentionally NOT set: the copyright line renders
                         as an inceptionYear-currentYear range ("2022 - 2026"), so every header would
                         flip to "not up to date", failing every build, the moment the calendar year
                         rolls over, until someone re-runs the sweep. failOnMissingHeader alone
                         already covers the regression this gate exists for. -->
                    <execution>
                        <id>validate-license-headers</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>update-file-header</goal>
                        </goals>
                        <configuration>
                            <dryRun>true</dryRun>
                            <failOnMissingHeader>true</failOnMissingHeader>
                        </configuration>
                    </execution>
                    <!-- Manual, unbound sweep for this module's web static assets (fc-demo-portal
                         only; harmless no-op elsewhere since the include patterns won't match).
                         Invoke explicitly: `mvn -pl fc-demo-portal license:update-file-header@sweep-web-assets`.
                         Vendored third-party scripts are excluded, since they are not project IP:
                         those under .../static/**/lib/** by directory, and minified vendor scripts
                         elsewhere (e.g. fc-service-server's jquery-3.6.3.min.js, jquery-ui.min.js)
                         by the **/*.min.js pattern. -->
                    <execution>
                        <id>sweep-web-assets</id>
                        <goals>
                            <goal>update-file-header</goal>
                        </goals>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/*.html</include>
                                <include>**/*.js</include>
                            </includes>
                            <excludes combine.self="override">
                                <exclude>**/lib/**</exclude>
                                <exclude>**/*.min.js</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- Manual, unbound sweep for repo-root assets that live outside any module's
                         src/ tree: shell scripts and docker-compose files under docker/, and Helm
                         chart YAML under deployment/helm/. Run once from the repo root (module -N):
                         `mvn -N license:update-file-header@sweep-docker-and-helm`.
                         .claude/hooks/ is a different subtree entirely (not under docker/ or
                         deployment/), so it is never reached by this execution's roots.
                         Third-party files and files the properties transformer cannot handle
                         are listed in the execution's <excludes> below. -->
                    <execution>
                        <id>sweep-docker-and-helm</id>
                        <goals>
                            <goal>update-file-header</goal>
                        </goals>
                        <configuration>
                            <roots combine.self="override">
                                <root>${maven.multiModuleProjectDirectory}/docker</root>
                                <root>${maven.multiModuleProjectDirectory}/deployment/helm</root>
                            </roots>
                            <includes combine.self="override">
                                <include>**/*.sh</include>
                                <include>**/*.yaml</include>
                                <include>**/*.yml</include>
                            </includes>
                            <excludes combine.self="override">
                                <!-- Third-party Apache Software Foundation files (Jena Fuseki image build):
                                     not project IP, already carry the ASF header. -->
                                <exclude>**/fuseki/**</exclude>
                                <!-- Helm configmap embedding a shell script with a shebang inside a YAML literal
                                     block. The properties transformer treats any "#!" in the file as a shebang
                                     prolog and inserts the header after it, mid-block, producing invalid YAML.
                                     The header for this file is maintained by hand. -->
                                <exclude>**/postgres-configmap.yaml</exclude>
                            </excludes>
                            <extraExtensions>
                                <yaml>properties</yaml>
                                <yml>properties</yml>
                            </extraExtensions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>arm64</id>
            <activation>
                <os>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>io.zonky.test.postgres</groupId>
                        <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
                        <version>${embedded.postgres.binaries.version}</version>
                        <scope>test</scope>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>
    </profiles>

</project>
