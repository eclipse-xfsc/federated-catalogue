            <!-- Import Jena's own BOM so EVERY Jena artifact converges on ${jena.version},
                 whatever path it arrives by. Needed because topbraid shacl 1.5.0 pulls
                 eu.neverblink.jelly:jelly-jena, which depends on an older jena-core; without
                 this import that older jena-core wins by nearest-path in the modules that do
                 not declare apache-jena-libs directly, mixing Jena majors on one classpath. -->
            <dependency>
                <groupId>org.apache.jena</groupId>
                <artifactId>apache-jena-libs</artifactId>
                <version>${jena.version}</version>
                <type>pom</type>
            </dependency>
            <!-- Pin the two foundational Jena artifacts explicitly. topbraid shacl pulls
                 eu.neverblink.jelly:jelly-jena, which declares its own older jena-core/jena-arq;
                 without these entries that older jena-core wins by nearest-path in the modules
                 that do not declare apache-jena-libs directly, mixing Jena majors on one
                 classpath. Deliberately NOT solved by importing org.apache.jena:jena-bom - that
                 BOM's inherited dependencyManagement also pins Spring Framework to 5.3.x, which
                 silently downgrades spring-web/spring-context below the Boot BOM. -->
            <dependency>
                <groupId>org.apache.jena</groupId>
                <artifactId>jena-core</artifactId>
                <version>${jena.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.jena</groupId>
                <artifactId>jena-arq</artifactId>
                <version>${jena.version}</version>
            </dependency>
            <dependency>
                <groupId>org.topbraid</groupId>
                <artifactId>shacl</artifactId>
                <!-- shacl declares its own jena-arq. No exclusion is needed: jena-arq is pinned
                     to ${jena.version} in this dependencyManagement block, which overrides
                     nearest-wins resolution. Excluding it instead would sever a real dependency
                     edge that only resolves today because apache-jena-libs happens to supply it. -->
                <version>${topbraid.version}</version>
            </dependency>
